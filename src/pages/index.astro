---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import CaseGrid from '../components/CaseGrid.astro';
import ConceptGallery from '../components/ConceptGallery.astro';
import { profile } from '../data/profile';
import { profileDescription } from '../data/work';
---
<SiteLayout title={`${profile.name} — ${profile.role}`} description={profileDescription}>
  <Hero />
  <CaseGrid />
  <ConceptGallery />
</SiteLayout>
