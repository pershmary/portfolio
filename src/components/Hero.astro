---
import { profile } from '../data/profile';
import { previewImage } from '../data/preview';
import Contacts from './Contacts.astro';
import Media from './Media.astro';

const portrait = profile.portrait?.image ?? await previewImage('portrait');
const hasPortraitArea = Boolean(portrait) || import.meta.env.DEV;
---
<section class:list={['hero', { 'hero-text-only': !hasPortraitArea }]} aria-labelledby="hello">
  {hasPortraitArea && <div class="hero-portrait media">
    <Media image={portrait} alt={profile.portrait?.alt ?? profile.name} placeholder="Место для портрета" priority sizes="(max-width: 680px) 116px, 218px" />
  </div>}
  <div class="hero-copy">
    <p class="hero-greeting">{profile.greeting} {profile.name}.</p>
    <h1 id="hello">{profile.headline}</h1>
    <div class="hero-details">
      <p class="hero-meta">{profile.role} <span aria-hidden="true">·</span> {profile.location}</p>
      <Contacts />
    </div>
    <div class="hero-bio">
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
