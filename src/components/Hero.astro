---
import { profile } from '../data/profile';
import { previewImage } from '../data/preview';
import Contacts from './Contacts.astro';
import Media from './Media.astro';

const portrait = profile.portrait?.image ?? await previewImage('portrait');
const hasPortraitArea = Boolean(portrait) || import.meta.env.DEV;
---
<section class="hero" aria-labelledby="hello">
  {hasPortraitArea && <div class="hero-portrait media">
    <Media image={portrait} alt={profile.portrait?.alt ?? profile.name} placeholder="Место для портрета" priority sizes="(max-width: 680px) 116px, 218px" />
  </div>}
  <div class="hero-copy">
    <h1 id="hello">{profile.greeting} {profile.name}, {profile.role}</h1>
    <p class="hero-bio">{profile.bio}</p>
    <Contacts />
  </div>
</section>
