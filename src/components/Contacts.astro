---
import { profile } from '../data/profile';

const contacts = profile.resume ? [...profile.contacts, profile.resume] : profile.contacts;
---
<ul class="contact-links" aria-label="Способы связи">
  {contacts.map(({ href, label, icon }) => <li><a href={href} target="_blank" rel="noopener noreferrer">
    {icon === 'email' && (
      <svg class="contact-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </svg>
    )}
    {icon === 'telegram' && (
      <svg class="contact-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m22 3-7.1 18-4.1-7.8L3 9.1 22 3ZM22 3 10.8 13.2" />
      </svg>
    )}
    {label}
  </a></li>)}
</ul>
