---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  priority?: boolean;
  placeholder?: string;
}

const { image, alt, sizes, priority = false, placeholder } = Astro.props;
const widths = image && sizes
  ? [...new Set([360, 540, 760, 1080, 1500].filter((width) => width < image.width).concat(Math.min(1800, image.width)))]
  : undefined;
---
{image ? (
  <Image
    src={image}
    alt={alt ?? ''}
    format="webp"
    quality={91}
    width={Math.min(1800, image.width)}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
  />
) : placeholder && import.meta.env.DEV && (
  <span class="media-placeholder">
    <span class="image-symbol" aria-hidden="true"></span>
    {placeholder}
  </span>
)}
