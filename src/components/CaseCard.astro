---
import { sitePath } from '../data/paths';
import type { CollectionEntry } from 'astro:content';
import { previewImage } from '../data/preview';
import Media from './Media.astro';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry: { data } } = Astro.props;
const cover = data.cover ?? await previewImage(data.slug);
const published = data.status === 'published';
const Card = published ? 'a' : 'article';
---
<Card class:list={['case-card', { 'case-link': published, 'case-card-text': !cover }]} href={published ? sitePath(`/cases/${data.slug}/`) : undefined}>
  {cover && <div class:list={['case-cover', 'media', `tone-${data.tone}`]}>
    <Media
      image={cover}
      alt={data.coverAlt ?? `Интерфейс проекта «${data.title}»`}
      sizes="(max-width: 680px) 100vw, (min-width: 1024px) calc(50vw - 100px), 49vw"
    />
  </div>}
  <div class="case-caption">
    <div class="case-heading">
      <h3>{data.title}</h3>
      {published && <span class="arrow arrow-out case-arrow" aria-hidden="true"></span>}
    </div>
    <p class="summary">{data.summary}</p>
    {!published && <p class="case-status">Кейс готовится</p>}
  </div>
</Card>
