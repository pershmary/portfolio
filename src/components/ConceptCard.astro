---
import type { CollectionEntry } from 'astro:content';
import { previewImage } from '../data/preview';
import Media from './Media.astro';

interface Props {
  entry: CollectionEntry<'concepts'>;
}

const { entry: { data } } = Astro.props;
const images = await Promise.all(data.images.map(async (item, index) => ({
  ...item,
  src: item.src ?? await previewImage(`${data.slug}-${index + 1}`),
})));
---
<article class="concept-card">
  <div class="concept-heading">
    <h3>{data.title}</h3>
    {data.summary && <p class="summary">{data.summary}</p>}
  </div>
  <div class="concept-images">
    {images.map(({ src, alt, caption }, index) => {
      const id = `${data.slug}-screen-${index + 1}`;

      return <figure>
        {src ? (
          <>
            <button class="concept-screen media" type="button" data-open-image={id} aria-label={`Увеличить изображение «${caption}»`} aria-haspopup="dialog">
              <Media image={src} alt={alt ?? `${data.title} — ${caption}`} sizes="(max-width: 680px) 100vw, 33vw" />
              <span class="zoom-mark" aria-hidden="true">+</span>
            </button>
            <dialog class="image-dialog" id={id} aria-labelledby={`${id}-title`}>
              <div class="dialog-top">
                <p id={`${id}-title`}>{caption}</p>
                <form method="dialog">
                  <button class="dialog-close" aria-label="Закрыть изображение" autofocus>×</button>
                </form>
              </div>
              <Media image={src} alt={alt ?? `${data.title} — ${caption}`} sizes="90vw" />
            </dialog>
          </>
        ) : (
          <div class="concept-screen media"><Media placeholder="Место для экрана" /></div>
        )}
        <figcaption>{caption}</figcaption>
      </figure>;
    })}
  </div>
  {data.prototypeUrl && <a class="text-link" href={data.prototypeUrl}>Открыть прототип <span class="arrow arrow-out" aria-hidden="true"></span></a>}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-image]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.openImage ?? '');
    if (!(dialog instanceof HTMLDialogElement)) return;

    button.addEventListener('click', () => dialog.showModal());
  });
</script>
