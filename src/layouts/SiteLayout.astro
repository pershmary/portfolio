---
import { sitePath } from '../data/paths';
import '@fontsource-variable/manrope';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  type?: 'website' | 'article';
  home?: boolean;
}

const {
  title, description, type = 'website', home = false,
  socialImage = profile.portrait?.image,
  socialImageAlt = profile.portrait?.alt,
} = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const ogImage = Astro.site && socialImage
  ? new URL((await getImage({ src: socialImage, width: Math.min(1200, socialImage.width), format: 'webp', quality: 91 })).src, Astro.site)
  : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={home ? "#ffffff" : "#f9f9f6"} />
    {import.meta.env.DEV && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
  </head>
  <body class:list={{ "portfolio-home": home }}>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header />
    <main class="container" id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
