---
import { sitePath } from '../data/paths';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import Media from '../components/Media.astro';
import { profile } from '../data/profile';
import { showWork } from '../data/work';

type Case = CollectionEntry<'cases'>;
interface Props {
  entry: Case;
  next?: Case;
}

const { entry: { data }, next } = Astro.props;
const meta = [data.role, data.year, data.readingTime && `${data.readingTime} мин чтения`].filter(Boolean);
---
<SiteLayout title={`${data.title} — ${profile.name}`} description={data.summary} type="article" socialImage={data.cover} socialImageAlt={data.coverAlt}>
  <article class="case-page">
    <header class="case-intro">
      <a class="text-link back-link" href={sitePath(showWork ? '/#cases' : '/')}><span class="arrow arrow-left" aria-hidden="true"></span> {showWork ? 'К списку кейсов' : 'На главную'}</a>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      {meta.length > 0 && <ul class="case-facts">{meta.map((item) => <li>{item}</li>)}</ul>}
      {data.tags && data.tags.length > 0 && <p class="case-tags">{data.tags.join(' · ')}</p>}
    </header>
    <div class:list={['case-cover', 'media', `tone-${data.tone}`]}>
      <Media image={data.cover} alt={data.coverAlt} priority sizes="(max-width: 1360px) 100vw, 1240px" />
    </div>
    <div class="case-prose">
      <slot />
    </div>
  </article>
  <nav class="case-navigation" aria-label="Навигация по кейсам">
    <a class="text-link" href={sitePath(showWork ? '/#cases' : '/')}><span class="arrow arrow-left" aria-hidden="true"></span> {showWork ? 'Все кейсы' : 'На главную'}</a>
    {next && <a class="text-link" href={sitePath(`/cases/${next.data.slug}/`)}>{next.data.title} <span class="arrow arrow-out" aria-hidden="true"></span></a>}
  </nav>
</SiteLayout>
